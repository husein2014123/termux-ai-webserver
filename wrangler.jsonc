{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ruangai",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  "vars": {
    "AI_MODEL": "openrouter/auto",
    "OPENROUTER_APP_TITLE": "RuangAI"
  }
}
